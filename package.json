{
  "name": "modeljars-catalog-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test site/assets/*.test.mjs tools/*.test.mjs",
    "catalog:enrich": "node tools/enrich-catalog.mjs",
    "catalog:inspect": "node tools/inspect-gguf.mjs",
    "catalog:triage": "node tools/triage-gguf.mjs",
    "catalog:modality": "node tools/modality-claim-gate.mjs",
    "catalog:modality:write": "node tools/modality-claim-gate.mjs --write",
    "catalog:verify-components": "node tools/component-evidence-gate.mjs --qualifications catalog/component-qualifications.json --models catalog/models.json",
    "catalog:verify-compositions": "node tools/composition-evidence-gate.mjs --compositions catalog/compositions.json --models catalog/models.json",
    "catalog:profiles": "node tools/generate-model-profiles.mjs --write",
    "catalog:profiles:check": "node tools/generate-model-profiles.mjs",
    "catalog:embeddings": "node tools/generate-embedding-qualifications.mjs --write",
    "catalog:embeddings:check": "node tools/generate-embedding-qualifications.mjs"
  },
  "devDependencies": {
    "@huggingface/jinja": "0.5.10"
  }
}
